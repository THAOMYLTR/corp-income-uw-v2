# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# THIS FILE IS NEVER READ. Copy it to a file named exactly ".env" (same folder
# as the notebook) and fill that one in. See README.md, "Configuration (.env)".
# On Databricks you can instead set os.environ[...] in notebook cell 3; then run
# the "check_llm_setup(config)" cell — it says what is missing before the run.

# -----------------------------------------------------------------------------
# PROVIDER — how the models are reached
# -----------------------------------------------------------------------------
# openai     : OpenAI, or any gateway that speaks the OpenAI format (default)
# anthropic  : Anthropic API (ANTHROPIC_API_KEY; ANTHROPIC_BASE_URL for a gateway)
# databricks : a Databricks model serving endpoint; MODEL_* = endpoint names
# databricks_invocations : the team convention {ANTHROPIC_API_BASE}/{model}/invocations,
#              key in OPENAI_API_KEY (chosen automatically when LLM_PROVIDER is empty
#              and ANTHROPIC_API_BASE is set)
LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# MODELS — three roles, one variable each
# -----------------------------------------------------------------------------
# build_llm() raises at startup naming the variable if one is unset, so a
# missing model is caught before any call is made rather than mid-run.
MODEL_DOCUMENT=gpt-4o-mini     # document classification (LLM fallback)
MODEL_ECONOMY=gpt-4o-mini      # BRD items 3-4 (legal representative, liabilities)
MODEL_PREMIUM=gpt-4o           # BRD items 1-2 (legal basics, shareholders) — the
                               # passes the MST / ownership checks are computed from

# -----------------------------------------------------------------------------
# API — fill the block for your LLM_PROVIDER
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_BASE=             # databricks_invocations only

DATABRICKS_HOST=
DATABRICKS_TOKEN=

# -----------------------------------------------------------------------------
# LLM TIMEOUT AND RETRIES
# -----------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=60

# Completion-token ceiling. MUST stay under the ceiling of every model in use:
# going over is a 400 that stops the run, not a quiet trim. Check
# each model's documentation for its real ceiling — they differ eightfold
# (gpt-4o-mini 16,384, gpt-5.4-mini 128,000).
LLM_MAX_TOKENS=16000

# Retries on 429/5xx. The SDK backs off and honours Retry-After.
LLM_CLIENT_MAX_RETRIES=3

# Optional ceiling on LLM requests per minute, shared by every client.
# 0 = off (same as the SME repo). Set it below your quota if you hit 429s.
LLM_REQUESTS_PER_MINUTE=0

# -----------------------------------------------------------------------------
# OCR — all optional; values below are the defaults the code applies
# -----------------------------------------------------------------------------
TESSERACT_CMD=                 # empty = found on PATH (/usr/bin/tesseract on Databricks)
OCR_LANG=vie+eng
OCR_DPI=300
OCR_PSM=6
OCR_OEM=3
OCR_CACHE_DIR=                 # empty = temp folder; set a Volume path to keep OCR between runs

# Digital PDFs (exported from Cổng ĐKDN, the tax portal…) are read from their
# text layer instead of OCR'd. 0 = always OCR.
PDF_TEXT_LAYER=1
OCR_TIMEOUT_SECONDS=           # per page; empty = no limit

# How many pages OCR at once. Tesseract runs out-of-process so this scales
# almost linearly: a 43-page statement went 96s -> 22s at 8 workers. Each
# worker holds a 300dpi page (~25 MB) plus its own tesseract process, so raise
# it with memory in mind. Empty/0 = 2 (safe on a small Databricks driver).
OCR_MAX_WORKERS=
# Files read at once (each also OCRs OCR_MAX_WORKERS pages) and LLM calls at once.
# Defaults 1 and 2; raise only on a large driver (memory = FILE_WORKERS x OCR_MAX_WORKERS pages).
FILE_WORKERS=
LLM_WORKERS=

# Image preprocessing before Tesseract.
OCR_PREPROCESS=0
OCR_DESKEW=1
OCR_DENOISE=0
OCR_BINARIZE=0
OCR_LAYOUT=1
OCR_DELINE=1
OCR_UPSCALE=1.0

# Correct pages rotated a quarter turn. OFF because the detector splits by
# angle, measured on the sample set: every 90° verdict was right (4/4) but
# every 180° verdict was wrong (4/4) and flipped an upright page into noise.
# Off therefore trades away the 90° repair to stop the 180° damage. Turn on
# for a scan set that is genuinely sideways. Costs ~2.2s per 43 pages.
OCR_AUTO_ROTATE=0
